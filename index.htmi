<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>デジタル回数券アプリ</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    /* Custom styles for precise visual reproduction */
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      user-select: none;
      -webkit-user-select: none;
      touch-action: pan-y;
      background-color: #1a1a1a;
    }
    
    /* Jagged perforation pattern at bottom of the swipable ticket */
    .perforated-edge {
      background-image: radial-gradient(circle, transparent 60%, #fff 65%);
      background-size: 16px 16px;
      background-position: bottom;
      background-repeat: repeat-x;
    }

    /* Top jagged edge of background lower ticket */
    .teeth-edge {
      position: relative;
    }
    .teeth-edge::before {
      content: "";
      position: absolute;
      top: -10px;
      left: 0;
      width: 100%;
      height: 10px;
      background-image: radial-gradient(circle at 50% 100%, #fffbf0 60%, transparent 65%);
      background-size: 16px 10px;
      background-repeat: repeat-x;
    }

    /* Circle dot spinner rotation animation */
    .dot-spinner {
      position: relative;
      width: 120px;
      height: 120px;
    }
    .dot-spinner-dot {
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background-color: #ccc;
      top: 54px;
      left: 54px;
    }

    /* Swipe transitions */
    .swipe-container {
      transition: transform 0.1s ease-out;
      will-change: transform;
    }
    .swipe-container.reset-anim {
      transition: transform 0.3s ease-in-out;
    }
  </style>
</head>
<body class="flex justify-center items-center min-h-screen p-0 sm:p-4">

  <div class="w-full max-w-[414px] h-[100vh] sm:h-[844px] bg-white flex flex-col justify-between shadow-2xl overflow-hidden relative sm:rounded-[40px] border-0 sm:border-[8px] border-black">
    
    <!-- Top Header Bar -->
    <header class="bg-white px-4 pt-3 pb-2 flex flex-col items-center border-b border-gray-100 z-10 shrink-0">
      <div class="w-full flex justify-between items-center relative mb-2">
        <div class="w-12"></div>
        <h1 class="text-base font-bold text-gray-800">回数券</h1>
        <span id="ticket-count-display" class="text-lg font-bold text-gray-700 w-12 text-right">2/2</span>
      </div>
      
      <!-- Tab Selector -->
      <div class="flex bg-gray-100 p-1 rounded-lg w-48 text-center text-sm font-medium">
        <button id="tab-1" class="flex-1 py-1 rounded-md bg-white shadow-sm font-semibold text-gray-800">1</button>
        <button id="tab-2" class="flex-1 py-1 text-gray-500">2</button>
      </div>
    </header>

    <!-- Main Content Body -->
    <main class="flex-1 overflow-y-auto relative bg-[#fffbf0] flex flex-col">
      
      <!-- UNUSED TICKET STATE (TOP TICKET SLIDER) -->
      <div id="unused-ticket-area" class="relative w-full overflow-hidden shrink-0 min-h-[170px] bg-[#fffbf0]">
        <!-- Background space revealed after sliding -->
        <div class="absolute inset-0 bg-gray-200 shadow-inner flex items-center justify-end pr-6 text-gray-400 font-bold text-sm">
          スライド完了
        </div>

        <!-- Draggable Ticket Block -->
        <div id="ticket-slider" class="swipe-container relative w-full bg-[#ebdccb] p-4 flex flex-col items-center justify-center border-b border-amber-200 cursor-grab active:cursor-grabbing select-none" style="min-height: 170px;">
          
          <!-- Bus Silhouette Background SVG -->
          <div class="absolute inset-0 flex items-center justify-center opacity-20 pointer-events-none overflow-hidden">
            <svg class="w-64 h-32 text-amber-800" fill="currentColor" viewBox="0 0 24 24">
              <path d="M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6h12v5z"/>
            </svg>
          </div>

          <!-- Instructions Bar inside ticket -->
          <div class="bg-[#f3e7da] px-4 py-1.5 rounded-sm shadow-sm mb-2 z-10">
            <span class="text-sm font-bold text-gray-800 tracking-wide">スライドして乗車券をもぎる➡</span>
          </div>
          
          <!-- Expiration Date -->
          <div class="text-xs font-semibold text-gray-700 z-10 mt-1">
            有効期限：2027/03/23
          </div>

          <!-- Bottom Jagged/Torn Edge Visual -->
          <div class="absolute -bottom-2 left-0 right-0 h-4 perforated-edge pointer-events-none"></div>
        </div>
      </div>

      <!-- USED TICKET STATE (ANIMATED SPINNER) -->
      <div id="used-ticket-area" class="hidden relative w-full pt-6 pb-4 flex flex-col items-center justify-center bg-white border-b border-gray-100">
        
        <!-- Rotating Circle Spinner -->
        <div class="relative flex items-center justify-center my-2">
          <div id="dot-spinner-container" class="dot-spinner"></div>
          
          <!-- Center Text -->
          <div class="absolute inset-0 flex flex-col items-center justify-center text-center pointer-events-none">
            <span class="text-xl font-bold text-[#a03820] tracking-wider leading-tight">使用済</span>
            <span class="text-sm font-extrabold text-[#a03820] tracking-widest leading-none mt-0.5">USED</span>
          </div>
        </div>

        <!-- Real-time / Dynamic Date Display -->
        <div id="used-date-time" class="text-2xl font-bold text-gray-800 tracking-wider mt-2">
          2026/09/24 10:49
        </div>
      </div>

      <!-- Lower Fixed Content Block -->
      <div class="teeth-edge px-5 pt-4 pb-6 flex-1 flex flex-col justify-between">
        
        <!-- Route / Usage Title Block -->
        <div class="text-center my-2">
          <!-- Top Purple Dotted Line -->
          <div class="flex justify-between items-center text-[#552781] font-bold text-xs overflow-hidden tracking-widest mb-3">
            ■■■■■■■■■■■■■■■■■■■■■■■
          </div>

          <h2 class="text-lg font-extrabold text-[#552781] mb-2 tracking-widest">【利用券】</h2>
          
          <div class="text-2xl font-extrabold text-[#552781] tracking-wider my-1">
            東京薬科大学
          </div>
          
          <div class="text-2xl font-extrabold text-[#552781] my-1">
            ↓↑
          </div>
          
          <div class="text-2xl font-extrabold text-[#552781] tracking-wider my-1">
            豊田駅
          </div>

          <!-- Bottom Purple Dotted Line -->
          <div class="flex justify-between items-center text-[#552781] font-bold text-xs overflow-hidden tracking-widest mt-3">
            ■■■■■■■■■■■■■■■■■■■■■■■
          </div>
        </div>

        <!-- Cautions / Notice Section -->
        <div class="mt-4 text-left">
          <div class="font-bold text-gray-900 text-sm mb-1">【注意事項】</div>
          <p class="font-bold text-gray-900 text-base leading-snug tracking-tight mb-4">
            必ず乗車直前にもぎり操作を行い、使用済の状態の画面を提示してください。
          </p>
          <div class="text-xs font-semibold text-gray-800">
            決済番号：00085741638
          </div>
        </div>

      </div>
    </main>

    <!-- Bottom Footer Navigation -->
    <footer class="bg-white border-t border-gray-200 py-2 px-3 grid grid-cols-5 text-center shrink-0 z-10">
      <div class="flex flex-col items-center justify-center text-gray-400">
        <i class="fa-solid fa-house text-lg mb-1"></i>
        <span class="text-[10px]">予約</span>
      </div>
      <div class="flex flex-col items-center justify-center text-[#21a884] font-bold">
        <i class="fa-solid fa-ticket text-lg mb-1"></i>
        <span class="text-[10px]">チケット</span>
      </div>
      <div class="flex flex-col items-center justify-center text-gray-400">
        <i class="fa-solid fa-list-ul text-lg mb-1"></i>
        <span class="text-[10px]">予約一覧</span>
      </div>
      <div class="flex flex-col items-center justify-center text-gray-400">
        <i class="fa-solid fa-book-open text-lg mb-1"></i>
        <span class="text-[10px]">NEWS</span>
      </div>
      <div class="flex flex-col items-center justify-center text-gray-400">
        <i class="fa-solid fa-gear text-lg mb-1"></i>
        <span class="text-[10px]">設定</span>
      </div>
    </footer>

    <!-- Confirmation Dialog Modal -->
    <div id="confirmation-modal" class="hidden absolute inset-0 bg-black/40 backdrop-blur-[1px] z-50 flex items-center justify-center px-6">
      <div class="bg-white/95 w-full max-w-xs rounded-2xl shadow-2xl overflow-hidden text-center flex flex-col pt-5">
        
        <div class="px-5 pb-4">
          <p class="text-xs font-bold text-gray-800 leading-relaxed mb-4">
            チケットをもぎりますか？<br>
            もぎる場合は、下のチェックをいれてから<br>
            OKをタップしてください。
          </p>
          
          <!-- Custom Teal Checkbox Box -->
          <div class="flex justify-center items-center my-3">
            <button id="modal-checkbox-btn" class="w-10 h-10 border-2 border-[#54b1a3] bg-white flex items-center justify-center rounded-sm focus:outline-none transition-colors">
              <i id="modal-checkmark" class="fa-solid fa-check text-2xl text-red-600 hidden"></i>
            </button>
          </div>
        </div>

        <!-- Modal Action Buttons -->
        <div class="border-t border-gray-200 grid grid-cols-2 text-sm font-semibold h-12">
          <button id="modal-cancel-btn" class="border-r border-gray-200 text-[#007aff] active:bg-gray-100 flex items-center justify-center h-full">
            CANCEL
          </button>
          <button id="modal-ok-btn" disabled class="text-gray-300 flex items-center justify-center h-full cursor-not-allowed">
            OK
          </button>
        </div>

      </div>
    </div>

  </div>

  <script>
    // App State Management
    let startX = 0;
    let currentX = 0;
    let isDragging = false;
    let isChecked = false;
    let isUsed = false;

    // DOM Elements
    const slider = document.getElementById('ticket-slider');
    const modal = document.getElementById('confirmation-modal');
    const checkboxBtn = document.getElementById('modal-checkbox-btn');
    const checkmark = document.getElementById('modal-checkmark');
    const cancelBtn = document.getElementById('modal-cancel-btn');
    const okBtn = document.getElementById('modal-ok-btn');
    const unusedArea = document.getElementById('unused-ticket-area');
    const usedArea = document.getElementById('used-ticket-area');
    const ticketCountDisplay = document.getElementById('ticket-count-display');
    const usedDateTimeDisplay = document.getElementById('used-date-time');

    // Generate Dot Spinner Elements dynamically
    const spinnerContainer = document.getElementById('dot-spinner-container');
    const totalDots = 12;
    const dots = [];
    const radius = 45; // radius in px

    for (let i = 0; i < totalDots; i++) {
      const dot = document.createElement('div');
      dot.className = 'dot-spinner-dot';
      const angle = (i * (360 / totalDots)) * (Math.PI / 180);
      const x = Math.round(radius * Math.sin(angle));
      const y = Math.round(-radius * Math.cos(angle));
      dot.style.transform = `translate(${x}px, ${y}px)`;
      spinnerContainer.appendChild(dot);
      dots.push(dot);
    }

    // Dot Rotation Animation Controller
    let activeDotIndex = 0;
    function animateSpinner() {
      dots.forEach((dot, index) => {
        if (index === activeDotIndex) {
          dot.style.backgroundColor = '#b06030'; // Brown active dot
          dot.style.transform = `translate(${Math.round(radius * Math.sin((index * 30) * Math.PI / 180))}px, ${Math.round(-radius * Math.cos((index * 30) * Math.PI / 180))}px) scale(1.3)`;
        } else {
          dot.style.backgroundColor = '#ccc'; // Gray inactive dot
          dot.style.transform = `translate(${Math.round(radius * Math.sin((index * 30) * Math.PI / 180))}px, ${Math.round(-radius * Math.cos((index * 30) * Math.PI / 180))}px) scale(1.0)`;
        }
      });
      activeDotIndex = (activeDotIndex + 1) % totalDots;
    }
    setInterval(animateSpinner, 120);

    // Format Current Date and Time (YYYY/MM/DD HH:mm)
    function updateDateTime() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      const hours = String(now.getHours()).padStart(2, '0');
      const minutes = String(now.getMinutes()).padStart(2, '0');
      usedDateTimeDisplay.textContent = `${year}/${month}/${day} ${hours}:${minutes}`;
    }

    // Touch / Mouse Drag Logic for Ticket Swiping
    function getClientX(e) {
      return e.touches ? e.touches[0].clientX : e.clientX;
    }

    function onDragStart(e) {
      if (isUsed) return;
      isDragging = true;
      startX = getClientX(e);
      slider.classList.remove('reset-anim');
    }

    function onDragMove(e) {
      if (!isDragging || isUsed) return;
      const x = getClientX(e);
      const diffX = x - startX;
      
      // Allow drag to the right only
      if (diffX > 0) {
        currentX = Math.min(diffX, slider.offsetWidth * 0.85);
        slider.style.transform = `translateX(${currentX}px)`;
      }
    }

    function onDragEnd() {
      if (!isDragging || isUsed) return;
      isDragging = false;
      const threshold = slider.offsetWidth * 0.35; // Trigger threshold

      if (currentX >= threshold) {
        // Keep ticket slid open and show modal
        slider.style.transform = `translateX(${slider.offsetWidth * 0.75}px)`;
        showModal();
      } else {
        // Reset slider position smoothly
        resetSlider();
      }
    }

    function resetSlider() {
      slider.classList.add('reset-anim');
      slider.style.transform = 'translateX(0px)';
      currentX = 0;
    }

    // Event Listeners for Touch and Mouse
    slider.addEventListener('touchstart', onDragStart, { passive: true });
    slider.addEventListener('touchmove', onDragMove, { passive: true });
    slider.addEventListener('touchend', onDragEnd);

    slider.addEventListener('mousedown', onDragStart);
    window.addEventListener('mousemove', onDragMove);
    window.addEventListener('mouseup', onDragEnd);

    // Modal Interaction Handlers
    function showModal() {
      isChecked = false;
      updateCheckboxState();
      modal.classList.remove('hidden');
    }

    function hideModal() {
      modal.classList.add('hidden');
    }

    checkboxBtn.addEventListener('click', () => {
      isChecked = !isChecked;
      updateCheckboxState();
    });

    function updateCheckboxState() {
      if (isChecked) {
        checkmark.classList.remove('hidden');
        okBtn.disabled = false;
        okBtn.className = 'text-[#007aff] font-bold flex items-center justify-center h-full active:bg-gray-100 cursor-pointer';
      } else {
        checkmark.classList.add('hidden');
        okBtn.disabled = true;
        okBtn.className = 'text-gray-300 flex items-center justify-center h-full cursor-not-allowed';
      }
    }

    cancelBtn.addEventListener('click', () => {
      hideModal();
      resetSlider();
    });

    // Confirm Ticket Usage
    okBtn.addEventListener('click', () => {
      if (!isChecked) return;
      
      isUsed = true;
      hideModal();
      updateDateTime();

      // Transition to USED state
      unusedArea.classList.add('hidden');
      usedArea.classList.remove('hidden');
      ticketCountDisplay.textContent = '1/2';
    });

    // Initial setup
    updateDateTime();
  </script>
</body>
</html>
